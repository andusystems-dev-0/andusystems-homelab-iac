// Nightly backup pipeline → S3. Configure in Jenkins (JCasC / multibranch) pointing
// at this repo. AWS + Pterodactyl DB creds come from Jenkins credentials (never here).
pipeline {
  agent {
    kubernetes {
      yaml '''
        apiVersion: v1
        kind: Pod
        spec:
          containers:
            - name: tools
              image: amazon/aws-cli:2
              command: ["cat"]
              tty: true
      '''
    }
  }
  triggers { cron('0 4 * * *') } // nightly 04:00
  environment {
    S3      = 'andusystems-pterodactyl-backups'
    STAMP   = sh(script: 'date +%Y-%m-%d', returnStdout: true).trim()
  }
  stages {
    stage('Pterodactyl: DB dump + volumes → S3') {
      steps {
        container('tools') {
          withCredentials([
            usernamePassword(credentialsId: 'ptero-db', usernameVariable: 'DBU', passwordVariable: 'DBP'),
            string(credentialsId: 'panel-host', variable: 'PANEL')
          ]) {
            sh '''
              ssh ubuntu@$PANEL "sudo docker exec ptero_database sh -c 'mariadb-dump -uroot -p\\"$DBP\\" --single-transaction --all-databases'" > panel-db.sql
              ssh ubuntu@$PANEL "sudo tar czf - -C /var/lib/pterodactyl volumes" > volumes.tgz
              aws s3 cp panel-db.sql  s3://$S3/daily/$STAMP/panel-db.sql
              aws s3 cp volumes.tgz   s3://$S3/daily/$STAMP/volumes.tgz
              aws s3 cp panel-db.sql  s3://$S3/latest/panel-db.sql
            '''
          }
        }
      }
    }
    stage('Prune backups older than 14 days') {
      steps {
        container('tools') {
          sh 'aws s3 ls s3://$S3/daily/ | awk \'{print $2}\' | sort | head -n -14 | xargs -I{} aws s3 rm --recursive s3://$S3/daily/{} || true'
        }
      }
    }
  }
}
