# Static NFS PV/PVC for the Jellyfin media library on the persistent NAS VM.
# The NAS IP comes from the gitignored vault (nas_ip), so the repo stays IP-free.
# The library lives OUTSIDE the k3s cluster → survives a destroy/recreate with zero
# backup/restore; ArgoCD's jellyfin app just binds this PVC via persistence.media.existingClaim.
apiVersion: v1
kind: PersistentVolume
metadata:
  name: jellyfin-media-nfs
  labels:
    app.kubernetes.io/name: jellyfin
spec:
  capacity:
    storage: 1000Gi
  accessModes: [ReadWriteMany]
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  mountOptions: [nfsvers=4.1, hard, noatime]
  nfs:
    server: "{{ nas_ip }}"
    path: /srv/media
  claimRef:
    namespace: jellyfin
    name: jellyfin-media-nfs
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: jellyfin-media-nfs
  namespace: jellyfin
spec:
  accessModes: [ReadWriteMany]
  storageClassName: ""
  volumeName: jellyfin-media-nfs
  resources:
    requests:
      storage: 1000Gi
