# Copy to /etc/anduripper.env on the NAS for INSTANT Jellyfin scans after each rip.
# Without it, rips still land in the library and Jellyfin's scheduled scan picks them up.
# Create the token in Jellyfin: Dashboard → Advanced → API Keys → New.
JELLYFIN_URL=https://jellyfin.andusystems.com
JELLYFIN_TOKEN=paste-your-jellyfin-api-key-here
